[Unit]
Description=Prometheus Process Exporter
Documentation=https://github.com/ncabatoff/process-exporter
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Track only the aos_* apps used by tools/grafana dashboards and skip
# per-thread metrics (--threads=false) to reduce /proc scanning overhead.
# Unused group metrics are dropped at scrape time by VictoriaMetrics.
ExecStart=/usr/bin/process-exporter \
    --config.path=/etc/process-exporter/aos-apps.yaml \
    --threads=false
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
